    "@mastra/pg": "^1.32.0",
    "dotenv": "^18.0.9",
    "drizzle-orm": "^0.45.0",
    "next": "^16.3.8",
    "pg": "^8.13.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "@types/react": "^19.0.0",
    "drizzle-kit": "^0.31.0",
