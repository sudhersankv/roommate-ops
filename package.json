{
  "name": "roomie",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start -p ${PORT:-3000}",
    "seed": "tsx --env-file=.env scripts/seed.ts",
