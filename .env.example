# Neon Postgres (app data + Mastra memory). Locally this MUST be the `dev` branch of project roomie
# (neon connection-string dev --pooled), never production: seed, dev-chat, evals and test:tools write to it, and a
# local `npm run dev` runs the scheduler. Production's URL lives only in `fly secrets`. A fresh dev branch is a copy of
# prod: run `npx tsx scripts/scrub-dev.ts` on it first (drops the real Groups, the WhatsApp login, contacts, traces).
DATABASE_URL=postgres://user:pass@ep-xxx.us-east-2.aws.neon.tech/roomie?sslmode=require

# LLM: Neon AI Gateway through Mastra's model router ("neon/<id>", see lib/llm.ts).
# Neon Console -> branch -> Connect -> "AI Gateway" tab. Base URL is the bare host (no /v1);
# the token is the gateway credential from "Reveal credential" (scope ai_gateway:invoke), NOT a napi_ API key.
# Model ids must be in the branch catalog: curl "$NEON_AI_GATEWAY_BASE_URL/v1/models" -H "Authorization: Bearer $NEON_AI_GATEWAY_TOKEN"
NEON_AI_GATEWAY_BASE_URL=https://br-xxxx-api.ai.c-2.us-east-2.aws.neon.tech
NEON_AI_GATEWAY_TOKEN=
LLM_MODEL=claude-sonnet-5-5
SMALL_MODEL=claude-haiku-5-5
# The Gate (System One endpoint {base}/typesafe/v1/systemone, not chat completions)
GATE_MODEL=typesafeai-jev-1-14-0
# Semantic recall ({base}/v1/embeddings); EMBED_DIM must match the model (the vector table is memory_messages_<dim>)
EMBED_MODEL=qwen3-embedding-0-6b
EMBED_DIM=1024

# Voice notes -> text through the Neon AI Gateway (Gemini transcribes the note). Optional override; an old
# OpenRouter-style id ("google/...") is ignored.
STT_MODEL=gemini-3-5-flash

# Mastra platform (tracing). Optional: without both, traces go to Postgres only (Studio).
MASTRA_PLATFORM_ACCESS_TOKEN=
MASTRA_PROJECT_ID=

# Composio (Splitwise and Instacart). app.composio.dev -> Settings -> API keys (a project key, "ak_...").
# Without a working key the Settings card says Splitwise isn't available, and dev-chat uses the in-memory fake.
COMPOSIO_API_KEY=
# The Splitwise auth config (Composio-managed OAuth). Leave empty and the first Connect finds or creates one and logs
# its id ("ac_..."); paste it here so every process uses the same one.
COMPOSIO_SPLITWISE_AUTH_CONFIG_ID=
# Optional: pin the Splitwise toolkit version for tools.execute (e.g. 20250909_00); empty = latest.
COMPOSIO_SPLITWISE_VERSION=
# Dev/tests: 1 = use the in-memory Splitwise fake instead of Composio (also works for the dashboard).
SPLITWISE_FAKE=
# Instacart through Composio is a "no auth" toolkit: no auth config or connection, just COMPOSIO_API_KEY.
# Optional: the Composio user id Instacart calls run as (default roomie-app) and a pinned toolkit version.
COMPOSIO_INSTACART_USER_ID=
COMPOSIO_INSTACART_VERSION=
# Dev/tests: 1 = Instacart links come from a fake (https://instacart.example/...); the dashboard button stays disabled.
INSTACART_FAKE=
# Optional: the model that writes Recipes (default LLM_MODEL). RECIPE_FAKE=1 returns a sample "Tacos for 5".
RECIPE_MODEL=

# Optional: the vision model that reads receipt photos (default LLM_MODEL). RECEIPT_FAKE=1 returns a sample receipt.
RECEIPT_MODEL=

# Lease Inbox (ADR 0016): AgentMail (console.agentmail.to -> API keys) and the webhook endpoint's signing secret
# (whsec_..., for <APP_URL>/api/mail). Without a key Lease Inbox can't be taught, unless MAIL_FAKE=1 (dev-chat, tests,
# evals: an in-memory inbox, and outside production POST /api/mail with `x-roomie-fake-mail: 1` skips the signature).
# MAIL_CLASSIFIER_FAKE=1 sorts mail and answers lease questions by keywords instead of SMALL_MODEL.
# AGENTMAIL_DOMAIN: the domain Group inboxes are made on (verified on the AgentMail org; production: tryroomie.me);
# unset -> agentmail.to.
AGENTMAIL_API_KEY=
AGENTMAIL_WEBHOOK_SECRET=
AGENTMAIL_DOMAIN=
MAIL_FAKE=
MAIL_CLASSIFIER_FAKE=

# Documents (receipts, the lease, kept photos) live in Neon Object Storage: a private bucket on this branch (neon.ts
# `buckets`, then `neon deploy`; credentials via `neon env pull`). Locally use the dev branch's bucket, never prod's.
# The AWS-standard names Neon injects (AWS_ENDPOINT_URL_S3, AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, AWS_REGION) work
# too; NEON_STORAGE_* wins. Without endpoint, bucket and keys (or with BLOB_FAKE=1) files are kept in memory and lost on
# restart (tests, evals, dev-chat). In production (NODE_ENV=production) missing storage is an error: set NEON_STORAGE_*,
# or BLOB_FAKE=1 to accept that Documents don't survive a restart.
NEON_STORAGE_ENDPOINT=
NEON_STORAGE_BUCKET=
NEON_STORAGE_ACCESS_KEY=
NEON_STORAGE_SECRET_KEY=
NEON_STORAGE_REGION=
BLOB_FAKE=

# Base URL for links Roomie sends (dashboard buttons and Claim links). Telegram refuses localhost buttons, so with a
# local URL those links go as text; a tunnel's https URL gives real buttons. With the production bot's token
# (@imroomiebot), `npm run telegram` and `telegram:webhook -- --delete` refuse (they'd take it from every real group), and
# `--set` refuses any target but https://tryroomie.me; ALLOW_PROD_BOT=1 overrides. Locally, use your own dev bot.
APP_URL=http://localhost:3000
ALLOW_PROD_BOT=

# Telegram (docs/telegram.md). BotFather: /newbot, then /setprivacy -> Disable and /setjoingroups -> Enable.
# Local dev polls (npm run telegram); the webhook (npm run telegram:webhook -- --set) needs a public https APP_URL.
TELEGRAM_BOT_TOKEN=
# The bot's username without the @ (e.g. roomie_house_bot)
TELEGRAM_BOT_USERNAME=
# Webhook only: the secret Telegram sends in X-Telegram-Bot-Api-Secret-Token (1-256 chars: A-Z a-z 0-9 _ -)
TELEGRAM_WEBHOOK_SECRET=
# WhatsApp (docs/whatsapp.md): 1 = this process holds Roomie's WhatsApp session (Baileys, stored in Postgres) and
# connects at start when a linked login is saved; link the number at /admin/whatsapp. Only ONE process may hold it:
# leave it 0 locally while Fly has it on (local runs: npm run whatsapp).
WHATSAPP_ENABLED=
# Baileys' own log level: trace / debug / info / warn (default) / error / silent
WA_LOG=
# Google emails (comma-separated) allowed on the operator pages (/admin/whatsapp); everyone else gets a 404
ROOMIE_OPERATOR_EMAILS=

# Pause before the intro after Roomie joins a group (default 60000); pause after "typing" before a reply
# (Telegram: 600-1800 ms at random, WhatsApp: 1200-3200 ms; 0 turns it off)
JOIN_DELAY_MS=
REPLY_DELAY_MS=

# Neon Auth (Managed Better Auth, Google sign-in). Neon Console -> branch -> Auth -> Configuration: the Auth URL.
# Each branch has its own Auth; locally use the dev branch's (the same ep-... host as DATABASE_URL).
# The cookie secret is ours: 32+ characters, e.g. `openssl rand -base64 32`.
NEON_AUTH_BASE_URL=https://ep-xxx.neonauth.us-east-2.aws.neon.tech/neondb/auth
NEON_AUTH_COOKIE_SECRET=

# Dev only (ignored when NODE_ENV=production): treat this email's Account as signed in, skipping Google.
# For automated browser checks; claim a Member with /claim/<token> while it's set. Leave empty normally.
DEV_AUTH_EMAIL=
